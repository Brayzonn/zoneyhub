# Copy to .env and adjust per environment. All values are optional — the app
# falls back to production defaults when a variable is unset.

# Google Analytics 4 measurement ID.
VITE_GA_MEASUREMENT_ID=G-02YZV44RB1

# Public site origin used for canonical / Open Graph URLs (no trailing slash).
VITE_SITE_URL=https://zoneyhub.com
